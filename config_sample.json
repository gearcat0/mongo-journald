{
  "mongo": {
    "database": "syslog",
    "collection": "events"
  },
  "retention": "60d",
  "priority": 6,
  "redact": true,
  "cursorFile": "/var/lib/mongo-journald/cursor",
  "units": {
    "deny": [],
    "allow": []
  },
  "batch": {
    "size": 500,
    "buffer": 10000,
    "flush": "1s"
  },
  "rawFields": false,
  "dns": {
    "retention": "3d",
    "rollupRetention": "60d",
    "ignore": []
  },
  "flows": {
    "retention": "3d",
    "rollupRetention": "60d",
    "proc": true,
    "includeLoopback": false,
    "ignore": {
      "cidrs": [],
      "ports": []
    }
  }
}
